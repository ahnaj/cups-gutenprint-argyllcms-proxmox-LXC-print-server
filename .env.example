# Copy to .env and edit before running `docker compose up -d`

# CUPS web-UI/admin login
CUPS_USER=admin
CUPS_PASSWORD=changeme
CUPS_ADMIN_EMAIL=admin@example.local

# Hostname CUPS advertises itself as (also used for mDNS/Bonjour)
SERVER_NAME=cups-print-server

# Host port to expose the CUPS web UI / IPP on
CUPS_PORT=631

# Container timezone
TZ=Etc/UTC
