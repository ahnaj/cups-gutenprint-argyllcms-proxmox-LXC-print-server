#!/usr/bin/env bash
# misc/build.func
#
# Shared helpers for creating and provisioning the cups-print-server LXC.
# Sourced by ct/cups-print-server.sh — not meant to be run directly.

# ---- output helpers -------------------------------------------------
CL_RESET="\033[0m"; CL_GREEN="\033[1;32m"; CL_YELLOW="\033[1;33m"; CL_RED="\033[1;31m"; CL_CYAN="\033[1;36m"

msg_info()  { echo -e " ${CL_CYAN}➜${CL_RESET} $1"; }
msg_ok()    { echo -e " ${CL_GREEN}✔${CL_RESET} $1"; }
msg_warn()  { echo -e " ${CL_YELLOW}⚠${CL_RESET} $1"; }
msg_error() { echo -e " ${CL_RED}✘${CL_RESET} $1" >&2; }

die() { msg_error "$1"; exit 1; }

# ---- environment checks ----------------------------------------------
check_root() {
  if [[ "$(id -u)" -ne 0 ]]; then
    die "This script must be run as root on the Proxmox VE host."
  fi
}

check_pve() {
  command -v pveversion >/dev/null 2>&1 || die "pveversion not found — this script must run on a Proxmox VE host."
}

next_free_ctid() {
  pvesh get /cluster/nextid 2>/dev/null || echo 900
}

# ---- default, overridable settings -----------------------------------
set_defaults() {
  CTID="${CTID:-$(next_free_ctid)}"
  HOSTNAME="${HOSTNAME:-cups-print-server}"
  DISK_SIZE_GB="${DISK_SIZE_GB:-4}"
  MEMORY_MB="${MEMORY_MB:-768}"
  SWAP_MB="${SWAP_MB:-512}"
  CORES="${CORES:-1}"
  BRIDGE="${BRIDGE:-vmbr0}"
  NET_CONFIG="${NET_CONFIG:-name=eth0,bridge=${BRIDGE},ip=dhcp}"
  STORAGE="${STORAGE:-local-lvm}"
  TEMPLATE_STORAGE="${TEMPLATE_STORAGE:-local}"
  OS_TEMPLATE="${OS_TEMPLATE:-}"          # auto-detected if empty
  UNPRIVILEGED="${UNPRIVILEGED:-1}"
  ENABLE_USB_PASSTHROUGH="${ENABLE_USB_PASSTHROUGH:-no}"
  INSTALL_SCRIPT_URL="${INSTALL_SCRIPT_URL:-https://raw.githubusercontent.com/ahnaj/cups-gutenprint-argyllcms-proxmox-LXC-print-server/main/install/cups-print-server-install.sh}"
}

# ---- template handling -------------------------------------------------
ensure_template() {
  if [[ -n "$OS_TEMPLATE" ]]; then
    return
  fi
  msg_info "Looking for a Debian 12 container template..."
  local found
  found=$(pveam list "${TEMPLATE_STORAGE}" 2>/dev/null | awk '/debian-12-standard/ {print $1}' | tail -n1)
  if [[ -z "$found" ]]; then
    msg_info "Template not found locally, downloading debian-12-standard..."
    pveam update >/dev/null
    local remote
    remote=$(pveam available --section system | awk '/debian-12-standard/ {print $2}' | tail -n1)
    [[ -n "$remote" ]] || die "Could not find a debian-12-standard template to download."
    pveam download "${TEMPLATE_STORAGE}" "$remote"
    found=$(pveam list "${TEMPLATE_STORAGE}" 2>/dev/null | awk '/debian-12-standard/ {print $1}' | tail -n1)
  fi
  OS_TEMPLATE="$found"
  msg_ok "Using template: ${OS_TEMPLATE}"
}

# ---- container lifecycle ----------------------------------------------
create_container() {
  msg_info "Creating LXC ${CTID} (${HOSTNAME})..."
  pct create "${CTID}" "${OS_TEMPLATE}" \
    --hostname "${HOSTNAME}" \
    --storage "${STORAGE}" \
    --rootfs "${STORAGE}:${DISK_SIZE_GB}" \
    --memory "${MEMORY_MB}" \
    --swap "${SWAP_MB}" \
    --cores "${CORES}" \
    --net0 "${NET_CONFIG}" \
    --unprivileged "${UNPRIVILEGED}" \
    --features nesting=1 \
    --onboot 1 \
    >/dev/null
  msg_ok "Container ${CTID} created."

  if [[ "${ENABLE_USB_PASSTHROUGH}" == "yes" ]]; then
    msg_info "Enabling USB passthrough for CTID ${CTID}..."
    {
      echo "lxc.cgroup2.devices.allow: c 189:* rwm"
      echo "lxc.mount.entry: /dev/bus/usb dev/bus/usb none bind,optional,create=dir"
    } >> "/etc/pve/lxc/${CTID}.conf"
    msg_ok "USB passthrough enabled (raw USB bus mounted into the container)."
  fi

  msg_info "Starting container..."
  pct start "${CTID}"
  # wait for networking to come up
  for _ in $(seq 1 30); do
    if pct exec "${CTID}" -- getent hosts deb.debian.org >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
  msg_ok "Container ${CTID} is running."
}

run_install_script() {
  msg_info "Fetching and running the install script inside CTID ${CTID}..."
  pct exec "${CTID}" -- bash -c "apt-get update -qq && apt-get install -y -qq curl >/dev/null"
  pct push "${CTID}" "${LOCAL_INSTALL_SCRIPT}" /root/cups-print-server-install.sh
  pct exec "${CTID}" -- bash /root/cups-print-server-install.sh
  msg_ok "Install script finished."
}

print_summary() {
  local ip
  ip=$(pct exec "${CTID}" -- hostname -I 2>/dev/null | awk '{print $1}')
  echo
  msg_ok "cups-print-server is up in CTID ${CTID}."
  echo -e "   ${CL_CYAN}Web UI:${CL_RESET} https://${ip}:631"
  echo -e "   ${CL_CYAN}Admin user:${CL_RESET} ${CUPS_USER}"
  echo
  msg_warn "Log into the container (pct enter ${CTID}) to add printers, or use lpadmin/system-config-printer."
}
